generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión sin pooler: la usan las migraciones (en Neon es distinta de DATABASE_URL).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  admin
  user
}

// kg: se vende por kilo (y opcionalmente por ½ kg). unidad: se vende por paquete / unidad.
enum SaleUnit {
  kg
  unidad
}

enum Presentation {
  medio_kg
  kg
  unidad
}

enum OrderStatus {
  pendiente
  preparando
  en_camino
  entregado
  cancelado
}

enum PaymentMethod {
  efectivo
  transferencia
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  sortOrder Int       @default(0)
  Product   Product[]
}

model Product {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String   @default("")
  unit        SaleUnit @default(kg)
  // Costo por kg o por unidad. Solo lo ven los administradores.
  cost        Float?
  // Multiplicador sobre el costo, como en la planilla (1.35 = 35 %). Solo admin.
  markup      Float?
  // Precio por kg o por unidad, según `unit`. Con costo y margen: costo × margen.
  price       Float    @default(0)
  // Precio por ½ kg: precio × (0,5 + recargo ½ kg). null = no se vende por ½ kg.
  priceHalf   Float?
  // Stock en kg (o en unidades si unit = unidad). Se descuenta con cada pedido
  // (½ kg = 0,5) y vuelve si se cancela. null = no se controla. Solo admin.
  stock       Float?
  // Variedades / sabores que el cliente elige al pedir (ej. "Original", "Vainilla").
  variants    String[] @default([])
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category     Category       @relation(fields: [categoryId], references: [id])
  categoryId   String
  ProductImage ProductImage[]
  OrderItem    OrderItem[]

  @@index([categoryId])
}

// Configuración general de la tienda (una sola fila, id = 1).
model StoreSetting {
  id              Int      @id @default(1)
  // Cuánto más caro es el ½ kg, en % del precio por kilo: ½ kg = kilo × (0,5 + 3,7 %).
  halfKgSurcharge Float    @default(3.7)
  updatedAt       DateTime @updatedAt
}

model ProductImage {
  id  Int    @id @default(autoincrement())
  url String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  password      String
  role          Role      @default(user)
  Order         Order[]
}

model Order {
  id     String @id @default(uuid())
  number Int    @unique @default(autoincrement())

  subtotal     Float
  total        Float
  itemsInOrder Int

  status      OrderStatus @default(pendiente)
  preparingAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  isPaid        Boolean       @default(false)
  paidAt        DateTime?
  paymentMethod PaymentMethod @default(efectivo)

  // Datos de entrega
  firstName String
  phone     String
  address   String
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sin cuenta: los pedidos de invitados no tienen usuario.
  user      User?       @relation(fields: [userId], references: [id])
  userId    String?
  OrderItem OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id           String       @id @default(uuid())
  quantity     Int
  price        Float
  presentation Presentation
  variant      String?

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  product   Product @relation(fields: [productId], references: [id])
  productId String
}
