DB_USER=postgres
DB_NAME=timonypumba
DB_PASSWORD=123456

# generado por: openssl rand -base64 32
AUTH_SECRET='reemplazar-por-un-secreto-generado'

# https://console.cloudinary.com -> Dashboard -> API Environment variable
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# En local las dos son iguales. En producción (Neon) DATABASE_URL es la "pooled"
# y DATABASE_URL_UNPOOLED la directa, que usan las migraciones.
DATABASE_URL="postgresql://postgres:123456@localhost:5432/timonypumba?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:123456@localhost:5432/timonypumba?schema=public"
